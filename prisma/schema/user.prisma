model User {
  id               String    @id @default(cuid())
  email            String    @unique
  username         String    @unique
  avatarUrl        String?
  passwordHash     String?
  isVerified       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  accounts         Account[]
  receivedRequests Friend[]  @relation("FriendReceiver")
  sentRequests     Friend[]  @relation("FriendRequester")

  expenses Expense[] //a user can have multiple expenses
  expenseParticipants ExpenseParticipant[]
  category Category[]
  memberships GroupMember[]
  settlementSent ExpenseSettlement[] @relation("SettlementPayer")
  settlementReceived ExpenseSettlement[] @relation("SettlementReceiver")
}
