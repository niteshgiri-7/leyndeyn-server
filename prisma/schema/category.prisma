model Category{
    id String @id @default(uuid())
    name String
    description String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId String?
    user User? @relation(fields:[userId],references: [id])

    groupId String?
    group Group? @relation(fields:[groupId],references: [id])

    budgets Budget[]
    expenses Expense[]

    @@unique([name,userId])
    @@unique([name,groupId])
}