model Group{
    id String @id @default(uuid())
    name String
    description String?
    invitationCode String @unique

    allowMembersToInvite Boolean @default(true)
    allowMembersToManageCategory Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    members GroupMember[]
    category Category[]
    expenses Expense[]
    
    settleMents ExpenseSettlement[]
}