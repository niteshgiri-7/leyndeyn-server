enum SplitStrategy {
   EQUAL
   EXACT
   PERCENTAGE
   NONE
}

model Expense{
    id String @id @default(uuid())
    amount Float
    description String
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    splitStrategy SplitStrategy @default(NONE)

    spentById String
    spentBy User @relation(fields:[spentById],references: [id])

    
    categoryId String
    category Category @relation(fields: [categoryId], references:[id])

    groupId String?
    group Group? @relation(fields: [groupId], references: [id])

    participants ExpenseParticipant[]
}