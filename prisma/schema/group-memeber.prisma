
enum GroupRole {
    MEMBER
    ADMIN
}

model GroupMember{
    id String @id @default(uuid())
    userId String
    groupId String
    joinedAt DateTime @default(now())  
    role GroupRole @default(MEMBER)

    user User @relation(fields: [userId], references: [id])
    group Group @relation(fields: [groupId], references: [id])
    
    @@unique([groupId,userId])
}